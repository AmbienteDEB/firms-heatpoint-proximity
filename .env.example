############################################
# CARPETA PARA GUARDAR LOS RESULTADOS
############################################
RESULTS_PATH='../results'

############################################
# FIRMS – DESCARGA DE PUNTOS DE CALOR
############################################

# Clave FIRMS (reemplazar en .env real)
FIRMS_MAP_KEY=

# Fuentes FIRMS (una llamada por source)
FIRMS_SOURCES=VIIRS_SNPP_NRT,VIIRS_NOAA20_NRT,VIIRS_NOAA21_NRT,MODIS_NRT

# Rango de días (1 a 5)
FIRMS_DAYS=1

# Fecha específica (opcional, comentar si no se usa)
# FIRMS_DATE=YYYY-MM-DD

# Bounding box: west,south,east,north (lon/lat en grados decimales)
# Ejemplo aproximado para El Salvador
FIRMS_BBOX=-90.13,13.15,-87.69,14.45


############################################
# POINTS VS POLYGONS (ANÁLISIS ESPACIAL)
############################################

# Shapefile / GeoPackage / GeoJSON de polígonos
POLYGONS_PATH=

# Campo del shapefile que identifica el área
POLYGONS_NAME_FIELD=nombre

# Buffer alrededor del polígono (km)
BUFFER_KM=2

# CRS de los puntos FIRMS
POINTS_CRS=EPSG:4326

# Solo usar si el shapefile NO tiene CRS
# FORCED_POLYGONS_CRS=EPSG:4326

# CRS métrico para cálculo de distancias (El Salvador)
METRIC_CRS=EPSG:32616


############################################
# GENERACIÓN DE IMÁGENES POR POLÍGONO
############################################

# Zoom de tiles satelitales
TILE_ZOOM=13

# Resolución de salida (72 mínimo práctico (pantalla), 300 estándar impresión, 600–1200 alta resolución)
DPI=300

# Modo de marcador (solo icon por ahora)
MARKER_MODE=icon

# Icono PNG para puntos (fondo transparente recomendado)
ICON_PATH=assets/fire.png

# Escala del icono
ICON_ZOOM=0.06

# Icono alternativo para puntos en buffer (opcional)
# BUFFER_ICON_PATH=assets/fire_buffer.png
# BUFFER_ICON_ZOOM=0.06
